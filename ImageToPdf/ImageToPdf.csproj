<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Version du produit : sans ces balises le binaire se déclarait 1.0.0.0 -->
    <Version>2.9.3</Version>
    <FileVersion>2.9.3.0</FileVersion>
    <AssemblyVersion>2.9.3.0</AssemblyVersion>
    <Product>PDF Merger</Product>
    <Company>CCAS</Company>
    <Copyright>© CCAS</Copyright>

    <!-- Icône de l'application (Explorateur, barre des tâches) -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embarquée aussi comme ressource pour l'icône de la fenêtre -->
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfSharpCore" Version="1.3.65" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.2" />
    <PackageReference Include="itext7" Version="8.0.2" />
    <!-- Encodages Windows (1252…) pour lire les fichiers texte « ANSI » -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

</Project>
